# lekiwi06 전방 60도 라이다 실험용 RViz 설정.
#
# lekiwi06_real.rviz 와 다른 점: Fixed Frame 이 map 이 아니라 base_link 다.
# 이 실험은 카토그래퍼도 AMCL 도 켜지 않으므로 map 프레임이 아예 없고,
# Fixed Frame 을 map 으로 두면 RViz 가 아무것도 못 그린다.
# Map 표시도 뺐다 (/map 이 없으므로).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
      Color: 100; 100; 100
      Line Style:
        Value: Lines
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Alpha: 0.6
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      # 이 노드는 sensor data QoS(BEST_EFFORT)로 발행한다. Reliable 로 두면
      # QoS 불일치로 구독이 성립하지 않아 화면에 아무것도 안 나온다.
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Style: Spheres
      Size (m): 0.03
      Alpha: 1
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frame Timeout: 15
      Value: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 180
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
      Invert Z Axis: false
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
